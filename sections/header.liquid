    {
      "type": "range",
      "id": "header_height",
      "min": 50,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.header_height.label",
      "default": 80
    },
    {
      "type": "range",
      "id": "header_max_width",
      "min": 800,
      "max": 1800,
      "step": 40,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.header_max_width.label",
      "default": 1280
    },
    {
      "type": "header",
      "content": "t:sections.aura_arc_header.settings.header__background.content"
    },
    {
      "type": "checkbox",
      "id": "transparent_at_top",
      "default": false,
      "label": "t:sections.aura_arc_header.settings.transparent_at_top.label",
      "info": "t:sections.aura_arc_header.settings.transparent_at_top.info"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "t:sections.aura_arc_header.settings.header_bg_color.label",
      "default": "#0e0e10"
    },
    {
      "type": "range",
      "id": "header_bg_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.aura_arc_header.settings.header_bg_opacity.label",
      "default": 80
