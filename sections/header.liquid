{{ 'aura-arc-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_opacity_decimal    = section.settings.header_bg_opacity | default: 80 | divided_by: 100.0
  assign bg_color_base         = section.settings.header_bg_color | default: '#0e0e10'
  assign header_bg_rgba        = bg_color_base | color_modify: 'alpha', bg_opacity_decimal

  assign scroll_opacity_dec    = section.settings.header_bg_opacity_scrolled | default: 90 | divided_by: 100.0
  assign scroll_bg_base        = section.settings.header_bg_color_scrolled | default: bg_color_base
  assign scroll_bg_rgba        = scroll_bg_base | color_modify: 'alpha', scroll_opacity_dec
  assign border_color_base     = section.settings.header_border_color | default: '#ffffff'
  assign border_color_rgba     = border_color_base | color_modify: 'alpha', 0.08
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --header-height:                  {{ section.settings.header_height }}px;
    --header-max-width:               {{ section.settings.header_max_width }}px;
    --logo-max-width:                 {{ section.settings.logo_width }}px;
    --announcement-bg:                {{ section.settings.announcement_bg }};
    --announcement-color:             {{ section.settings.announcement_color }};
    --announcement-font-size:         {{ section.settings.announcement_font_size }}px;
    --header-bg-color:                {{ header_bg_rgba }};
    --header-bg-color-scrolled:       {{ scroll_bg_rgba }};
    --header-border-color:            {{ border_color_rgba }};
    --header-text-color:              {{ section.settings.header_text_color }};
    --header-icon-color:              {{ section.settings.header_icon_color }};
    --header-blur-top:                {{ section.settings.header_blur_top | default: 0 }}px;
    --header-blur-scrolled:           {{ section.settings.header_blur | default: 20 }}px;
    --header-nav-color:               {{ section.settings.nav_text_color }};
    --header-nav-color-hover:         {{ section.settings.nav_text_color_hover }};
    --header-nav-size:                {{ section.settings.nav_font_size }}px;
    --header-nav-weight:              {{ section.settings.nav_font_weight }};
    --header-nav-gap:                 {{ section.settings.nav_gap }}px;
    --header-nav-justify:             {{ section.settings.nav_position | default: 'center' }};
    --header-cart-icon-size:          {{ section.settings.cart_icon_size | default: 28 }}px;
    --header-account-icon-size:       {{ section.settings.account_icon_size | default: 28 }}px;
    --header-title-size:              {{ section.settings.title_font_size }}px;
    --header-title-letter-spacing:    {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    --header-title-transform:         {{ section.settings.title_transform }};
    --header-title-weight:            {{ section.settings.title_font_weight }};
    --header-drawer-bg:               {{ section.settings.drawer_bg_color }};
    {%- if section.settings.accent_color != blank -%}
      --aura-arc-accent:              {{ section.settings.accent_color }};
    {%- endif -%}
  }

  {%- if section.settings.position_mode == 'sticky' -%}
    #shopify-section-{{ section.id }}.section-header {
      position: sticky;
      top: 0;
      z-index: 50;
      width: 100%;
    }
  {%- elsif section.settings.position_mode == 'fixed' -%}
    #shopify-section-{{ section.id }}.section-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      z-index: 50;
    }
  {%- endif -%}
{%- endstyle -%}

<!-- Top Announcement Bar -->
{%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
  <div class="aura-arc-announcement">
    {%- if section.settings.announcement_link != blank -%}
      <a href="{{ section.settings.announcement_link }}">
        {{ section.settings.announcement_text }}
      </a>
    {%- else -%}
      <span>{{ section.settings.announcement_text }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

<!-- Glassmorphic Header Navbar -->
<header class="aura-arc-header aura-arc-header--{{ section.settings.position_mode }}{% if section.settings.transparent_at_top %} aura-arc-header--transparent-top{% endif %}" id="AuraArcHeader">
  <div class="aura-arc-header__container">
    <!-- Brand Logo & Title -->
    <a href="{{ routes.root_url }}" class="aura-arc-header__brand">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            loading: 'eager',
            class: 'aura-arc-header__logo',
            widths: '100, 200, 300, 400, 600',
            alt: section.settings.logo.alt | default: shop.name | escape
        }}
      {%- endif -%}

      {%- if section.settings.show_title or section.settings.logo == blank -%}
        <span class="aura-arc-header__title">
          {{ section.settings.brand_title | default: shop.name | escape }}
        </span>
      {%- endif -%}
    </a>

    <!-- Navigation Links -->
    {%- assign main_menu = section.settings.menu | default: 'main-menu' -%}
    {%- if linklists[main_menu].links.size > 0 -%}
      <nav class="aura-arc-header__nav" aria-label="Main Navigation">
        {%- for link in linklists[main_menu].links -%}
          <a
            href="{{ link.url }}"
            class="aura-arc-header__nav-item{% if link.active %} aura-arc-header__nav-item--active{% endif %}"
            {% if link.active %}aria-current="page"{% endif %}
          >
            {{ link.title | escape }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <!-- Header Action Icons -->
    <div class="aura-arc-header__actions">
      <!-- Cart Link & Popup Trigger -->
      <a
        href="{{ routes.cart_url }}"
        class="aura-arc-header__cart-link"
        id="AuraCartTrigger"
        aria-label="{{ 'templates.cart.cart' | t | default: 'Cart' }}"
        {% if section.settings.cart_type == 'popup' %}aria-haspopup="dialog" aria-expanded="false"{% endif %}
      >
        <svg class="aura-arc-header__cart-icon" viewBox="0 0 24 24">
          <path d="M19 7h-3V6a4 4 0 0 0-8 0v1H5a1 1 0 0 0-1 1v11a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8a1 1 0 0 0-1-1zm-9-1a2 2 0 0 1 4 0v1h-4V6zm8 13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9h2v1a1 1 0 0 0 2 0V9h4v1a1 1 0 0 0 2 0V9h2v10z"/>
        </svg>
        <span class="aura-arc-header__cart-badge" id="CartCount">
          {{ cart.item_count }}
        </span>
      </a>

      <!-- Account Link -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="aura-arc-header__account-link{% if section.settings.account_in_drawer %} aura-arc-header__account-link--desktop-only{% endif %}"
          aria-label="{{ 'customer.account.title' | t }}"
        >
          <svg class="aura-arc-header__account-icon" viewBox="0 0 24 24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </a>
      {%- endif -%}

      <!-- Mobile Menu Toggle Button -->
      <button type="button" class="aura-arc-header__mobile-toggle" id="AuraMobileMenuToggle" aria-label="Toggle Mobile Menu">
        <svg class="aura-arc-header__toggle-icon" viewBox="0 0 24 24">
          <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Cart Quick Preview Popup Modal -->
  {%- if section.settings.cart_type == 'popup' -%}
    {%- assign cart_block = section.blocks | where: 'type', 'cart_popup' | first -%}
    {%- assign default_popup_title = 'sections.aura_arc_header.cart_popup.title' | t -%}
    {%- assign default_popup_empty = 'sections.aura_arc_header.cart_popup.empty' | t -%}
    {%- assign default_popup_btn = 'sections.aura_arc_header.cart_popup.view_cart' | t -%}
    {%- assign popup_title = cart_block.settings.title | default: default_popup_title -%}
    {%- assign popup_empty = cart_block.settings.empty_text | default: default_popup_empty -%}
    {%- assign popup_btn_text = cart_block.settings.button_text | default: default_popup_btn -%}
    {%- assign show_count = true -%}
    {%- assign show_sub = true -%}
    {%- if cart_block != blank -%}
      {%- assign show_count = cart_block.settings.show_item_count -%}
      {%- assign show_sub = cart_block.settings.show_subtotal -%}
    {%- endif -%}

    {%- style -%}
      {%- if cart_block != blank -%}
        {%- if cart_block.settings.match_header_bg -%}
          #AuraCartPopup {
            --cart-popup-width:          {{ cart_block.settings.card_width | default: 340 }}px;
            --cart-popup-blur:           var(--header-blur-scrolled);
            --cart-popup-bg:             var(--header-bg-color-scrolled);
            --cart-popup-border:         var(--header-border-color);
            --cart-popup-btn-color:      {{ cart_block.settings.button_text_color | default: 'var(--aura-arc-accent, #f2ca50)' }};
          }
        {%- else -%}
          {%- assign popup_bg_dec = cart_block.settings.bg_opacity | default: 95 | divided_by: 100.0 -%}
          {%- assign popup_bg_base = cart_block.settings.bg_color | default: '#101014' -%}
          {%- assign popup_bg_rgba = popup_bg_base | color_modify: 'alpha', popup_bg_dec -%}
          {%- assign popup_border_rgba = cart_block.settings.border_color | default: '#ffffff' | color_modify: 'alpha', 0.12 -%}
          #AuraCartPopup {
            --cart-popup-width:          {{ cart_block.settings.card_width | default: 340 }}px;
            --cart-popup-blur:           {{ cart_block.settings.blur_intensity | default: 24 }}px;
            --cart-popup-bg:             {{ popup_bg_rgba }};
            --cart-popup-border:         {{ popup_border_rgba }};
            --cart-popup-btn-color:      {{ cart_block.settings.button_text_color | default: 'var(--aura-arc-accent, #f2ca50)' }};
          }
        {%- endif -%}
      {%- endif -%}
    {%- endstyle -%}

    <div
      class="aura-arc-cart-popup"
      id="AuraCartPopup"
      role="dialog"
      aria-modal="true"
      aria-label="{{ popup_title | escape }}"
      {% if cart_block != blank %}{{ cart_block.shopify_attributes }}{% endif %}
    >
      <div class="aura-arc-cart-popup__card">
        <div class="aura-arc-cart-popup__header">
          <div class="aura-arc-cart-popup__title-group">
            <span class="aura-arc-cart-popup__title">
              {{ popup_title | escape }}
            </span>
            {%- if show_count -%}
              <span class="aura-arc-cart-popup__count">({{ cart.item_count }})</span>
            {%- endif -%}
          </div>

          <button
            type="button"
            class="aura-arc-cart-popup__close"
            id="AuraCartPopupClose"
            aria-label="{{ 'sections.aura_arc_header.cart_popup.close' | t }}"
          >
            <svg viewBox="0 0 24 24">
              <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
            </svg>
          </button>
        </div>

        <div class="aura-arc-cart-popup__body">
          {%- if cart.item_count == 0 -%}
            <p class="aura-arc-cart-popup__empty">
              {{ popup_empty | escape }}
            </p>
          {%- else -%}
            {%- if show_sub -%}
              <div class="aura-arc-cart-popup__summary">
                <span class="aura-arc-cart-popup__subtotal-label">
                  {{ 'sections.aura_arc_header.cart_popup.subtotal' | t }}
                </span>
                <span class="aura-arc-cart-popup__subtotal-amount">
                  {{ cart.total_price | money }}
                </span>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="aura-arc-cart-popup__footer">
          <a href="{{ routes.cart_url }}" class="aura-arc-cart-popup__btn">
            <span>{{ popup_btn_text | escape }}</span>
          </a>
        </div>
      </div>
    </div>
  {%- endif -%}
</header>

<!-- Mobile Drawer Navigation -->
<div class="aura-arc-header__drawer" id="AuraMobileDrawer">
  <div class="aura-arc-header__drawer-header">
    {%- if shop.customer_accounts_enabled and section.settings.account_in_drawer -%}
      <a
        href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
        class="aura-arc-header__drawer-account"
      >
        <span class="aura-arc-header__drawer-account-avatar">
          <svg class="aura-arc-header__drawer-account-icon" viewBox="0 0 24 24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </span>
        <span class="aura-arc-header__drawer-account-text">
          {%- if customer -%}
            {{ customer.first_name | default: 'customer.account.title' | t }}
          {%- else -%}
            {{ 'customer.account.title' | t }}
          {%- endif -%}
        </span>
      </a>
    {%- else -%}
      <div></div>
    {%- endif -%}

    <button type="button" class="aura-arc-header__drawer-close" id="AuraMobileDrawerClose" aria-label="Close Menu">
      <svg style="width: 1.5rem; height: 1.5rem; fill: currentColor;" viewBox="0 0 24 24">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
      </svg>
    </button>
  </div>

  {%- if linklists[main_menu].links.size > 0 -%}
    <nav class="aura-arc-header__drawer-nav">
      {%- for link in linklists[main_menu].links -%}
        <a
          href="{{ link.url }}"
          class="aura-arc-header__drawer-item{% if link.active %} aura-arc-header__drawer-item--active{% endif %}"
        >
          {{ link.title | escape }}
        </a>
      {%- endfor -%}
    </nav>
  {%- endif -%}
</div>

<div class="aura-arc-header__overlay" id="AuraMobileOverlay"></div>

<script>
  (function() {
    function initHeader() {
      const toggle = document.getElementById('AuraMobileMenuToggle');
      const closeBtn = document.getElementById('AuraMobileDrawerClose');
      const drawer = document.getElementById('AuraMobileDrawer');
      const overlay = document.getElementById('AuraMobileOverlay');
      const header = document.getElementById('AuraArcHeader');

      function openDrawer() {
        if (drawer) drawer.classList.add('aura-arc-header__drawer--open');
        if (overlay) overlay.classList.add('aura-arc-header__overlay--open');
      }

      function closeDrawer() {
        if (drawer) drawer.classList.remove('aura-arc-header__drawer--open');
        if (overlay) overlay.classList.remove('aura-arc-header__overlay--open');
      }

      if (toggle) toggle.addEventListener('click', openDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      if (overlay) overlay.addEventListener('click', closeDrawer);

      // Cart Popup Logic
      const cartTrigger = document.getElementById('AuraCartTrigger');
      const cartPopup = document.getElementById('AuraCartPopup');
      const cartPopupClose = document.getElementById('AuraCartPopupClose');

      function openCartPopup(e) {
        if (cartPopup) {
          if (e) e.preventDefault();
          cartPopup.classList.add('aura-arc-cart-popup--open');
          if (cartTrigger) cartTrigger.setAttribute('aria-expanded', 'true');
        }
      }

      function closeCartPopup() {
        if (cartPopup) {
          cartPopup.classList.remove('aura-arc-cart-popup--open');
          if (cartTrigger) cartTrigger.setAttribute('aria-expanded', 'false');
        }
      }

      if (cartTrigger && cartPopup) {
        cartTrigger.addEventListener('click', function(e) {
          if (cartPopup.classList.contains('aura-arc-cart-popup--open')) {
            closeCartPopup();
          } else {
            openCartPopup(e);
          }
        });
      }

      if (cartPopupClose) {
        cartPopupClose.addEventListener('click', closeCartPopup);
      }

      // Close popup if clicked outside or pressed Escape
      document.addEventListener('click', function(e) {
        if (cartPopup && cartPopup.classList.contains('aura-arc-cart-popup--open')) {
          if (!cartPopup.contains(e.target) && !cartTrigger.contains(e.target)) {
            closeCartPopup();
          }
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeCartPopup();
          closeDrawer();
        }
      });

      // Scroll listener for dark background & blur effect
      if (header) {
        let ticking = false;
        function onScroll() {
          const scrollY = window.pageYOffset || document.documentElement.scrollTop;
          if (scrollY > 15) {
            header.classList.add('aura-arc-header--scrolled');
          } else {
            header.classList.remove('aura-arc-header--scrolled');
          }
          ticking = false;
        }

        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(onScroll);
            ticking = true;
          }
        }, { passive: true });

        onScroll();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }

    document.addEventListener('shopify:section:load', initHeader);
  })();
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.aura_arc_header.settings.header__announcement.content"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "default": true,
      "label": "t:sections.aura_arc_header.settings.show_announcement.label"
    },
    {
      "type": "inline_richtext",
      "id": "announcement_text",
      "default": "Complimentary global shipping on orders over $500",
      "label": "t:sections.aura_arc_header.settings.announcement_text.label"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "t:sections.aura_arc_header.settings.announcement_link.label"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "default": "#161619",
      "label": "t:sections.aura_arc_header.settings.announcement_bg.label"
    },
    {
      "type": "color",
      "id": "announcement_color",
      "default": "#f2ca50",
      "label": "t:sections.aura_arc_header.settings.announcement_color.label"
    },
    {
      "type": "range",
      "id": "announcement_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.announcement_font_size.label",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:sections.aura_arc_header.settings.header__header.content"
    },
    {
      "type": "select",
      "id": "position_mode",
      "options": [
        { "value": "sticky", "label": "t:sections.aura_arc_header.settings.position_mode.options__1.label" },
        { "value": "fixed",  "label": "t:sections.aura_arc_header.settings.position_mode.options__2.label" },
        { "value": "static", "label": "t:sections.aura_arc_header.settings.position_mode.options__3.label" }
      ],
      "default": "sticky",
      "label": "t:sections.aura_arc_header.settings.position_mode.label"
    },
    {
      "type": "range",
      "id": "header_height",
      "min": 50,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.header_height.label",
      "default": 80
    },
    {
      "type": "range",
      "id": "header_max_width",
      "min": 800,
      "max": 1800,
      "step": 40,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.header_max_width.label",
      "default": 1280
    },
    {
      "type": "header",
      "content": "t:sections.aura_arc_header.settings.header__background.content"
    },
    {
      "type": "checkbox",
      "id": "transparent_at_top",
      "default": false,
      "label": "t:sections.aura_arc_header.settings.transparent_at_top.label",
      "info": "t:sections.aura_arc_header.settings.transparent_at_top.info"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "t:sections.aura_arc_header.settings.header_bg_color.label",
      "default": "#0e0e10"
    },
    {
      "type": "range",
      "id": "header_bg_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.aura_arc_header.settings.header_bg_opacity.label",
      "default": 80
    },
    {
      "type": "range",
      "id": "header_blur_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.header_blur_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.aura_arc_header.settings.header__scroll_effects.content"
    },
    {
      "type": "color",
      "id": "header_bg_color_scrolled",
      "label": "t:sections.aura_arc_header.settings.header_bg_color_scrolled.label",
      "default": "#0e0e10"
    },
    {
      "type": "range",
      "id": "header_bg_opacity_scrolled",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.aura_arc_header.settings.header_bg_opacity_scrolled.label",
      "default": 90
    },
    {
      "type": "range",
      "id": "header_blur",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.header_blur.label",
      "default": 20
    },
    {
      "type": "color",
      "id": "header_border_color",
      "label": "t:sections.aura_arc_header.settings.header_border_color.label",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:sections.aura_arc_header.settings.header__colors.content"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "t:sections.aura_arc_header.settings.header_text_color.label",
      "default": "#fbfbf9"
    },
    {
      "type": "color",
      "id": "header_icon_color",
      "label": "t:sections.aura_arc_header.settings.header_icon_color.label",
      "default": "#fbfbf9"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#f2ca50",
      "label": "t:sections.aura_arc_header.settings.accent_color.label"
    },
    {
      "type": "header",
      "content": "t:sections.aura_arc_header.settings.header__logo.content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.aura_arc_header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.logo_width.label",
      "default": 140
