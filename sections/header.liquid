{{ 'aura-arc-header.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --header-height: {{ section.settings.header_height }}px;
    --logo-max-width: {{ section.settings.logo_width }}px;
    --announcement-bg: {{ section.settings.announcement_bg }};
    --announcement-color: {{ section.settings.announcement_color }};
    {%- if section.settings.accent_color != blank -%}
      --aura-arc-accent: {{ section.settings.accent_color }};
    {%- endif -%}
  }
{%- endstyle -%}

<!-- Top Announcement Bar -->
{%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
  <div class="aura-arc-announcement">
    {%- if section.settings.announcement_link != blank -%}
      <a href="{{ section.settings.announcement_link }}">
        {{ section.settings.announcement_text }}
      </a>
    {%- else -%}
      <span>{{ section.settings.announcement_text }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

<!-- Glassmorphic Header Navbar -->
<header class="aura-arc-header aura-arc-header--{{ section.settings.position_mode }}">
  <div class="aura-arc-header__container">
    <!-- Brand Logo & Title -->
    <a href="{{ routes.root_url }}" class="aura-arc-header__brand">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            loading: 'eager',
            class: 'aura-arc-header__logo',
            widths: '100, 200, 300, 400, 600',
            alt: section.settings.logo.alt | default: shop.name | escape
        }}
      {%- endif -%}

      {%- if section.settings.show_title or section.settings.logo == blank -%}
        <span class="aura-arc-header__title">
          {{ section.settings.brand_title | default: shop.name | escape }}
        </span>
      {%- endif -%}
    </a>

    <!-- Navigation Links -->
    {%- assign main_menu = section.settings.menu | default: 'main-menu' -%}
    {%- if linklists[main_menu].links.size > 0 -%}
      <nav class="aura-arc-header__nav" aria-label="Main Navigation">
        {%- for link in linklists[main_menu].links -%}
          <a
            href="{{ link.url }}"
            class="aura-arc-header__nav-item{% if link.active %} aura-arc-header__nav-item--active{% endif %}"
            {% if link.active %}aria-current="page"{% endif %}
          >
            {{ link.title | escape }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <!-- Header Action Icons -->
    <div class="aura-arc-header__actions">
      <!-- Cart Link -->
      <a href="{{ routes.cart_url }}" class="aura-arc-header__cart-link" aria-label="{{ 'templates.cart.cart' | t | default: 'Cart' }}">
        <svg class="aura-arc-header__cart-icon" viewBox="0 0 24 24">
          <path d="M19 7h-3V6a4 4 0 0 0-8 0v1H5a1 1 0 0 0-1 1v11a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8a1 1 0 0 0-1-1zm-9-1a2 2 0 0 1 4 0v1h-4V6zm8 13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9h2v1a1 1 0 0 0 2 0V9h4v1a1 1 0 0 0 2 0V9h2v10z"/>
        </svg>
        <span class="aura-arc-header__cart-badge" id="CartCount">
          {{ cart.item_count }}
        </span>
      </a>

      <!-- Account Link -->
      {%- if shop.customer_accounts_enabled -%}
        <a 
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" 
          class="aura-arc-header__account-link" 
          aria-label="{{ 'customer.account_fallback' | t | default: 'Account' }}"
        >
          <svg class="aura-arc-header__account-icon" viewBox="0 0 24 24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </a>
      {%- endif -%}

      <!-- Mobile Menu Toggle Button -->
      <button type="button" class="aura-arc-header__mobile-toggle" id="AuraMobileMenuToggle" aria-label="Toggle Mobile Menu">
        <svg class="aura-arc-header__toggle-icon" viewBox="0 0 24 24">
          <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Navigation -->
<div class="aura-arc-header__drawer" id="AuraMobileDrawer">
  <button type="button" class="aura-arc-header__drawer-close" id="AuraMobileDrawerClose" aria-label="Close Menu">
    <svg style="width: 1.5rem; height: 1.5rem; fill: currentColor;" viewBox="0 0 24 24">
      <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
    </svg>
  </button>
  {%- if linklists[main_menu].links.size > 0 -%}
    <nav class="aura-arc-header__drawer-nav">
      {%- for link in linklists[main_menu].links -%}
        <a
          href="{{ link.url }}"
          class="aura-arc-header__drawer-item{% if link.active %} aura-arc-header__drawer-item--active{% endif %}"
        >
          {{ link.title | escape }}
        </a>
      {%- endfor -%}
    </nav>
  {%- endif -%}
</div>

<div class="aura-arc-header__overlay" id="AuraMobileOverlay"></div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('AuraMobileMenuToggle');
    const closeBtn = document.getElementById('AuraMobileDrawerClose');
    const drawer = document.getElementById('AuraMobileDrawer');
    const overlay = document.getElementById('AuraMobileOverlay');

    function openDrawer() {
      if (drawer) drawer.classList.add('aura-arc-header__drawer--open');
      if (overlay) overlay.classList.add('aura-arc-header__overlay--open');
    }

    function closeDrawer() {
      if (drawer) drawer.classList.remove('aura-arc-header__drawer--open');
      if (overlay) overlay.classList.remove('aura-arc-header__overlay--open');
    }

    if (toggle) toggle.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);
  });
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "default": true,
      "label": "t:sections.aura_arc_header.settings.show_announcement.label"
    },
    {
      "type": "inline_richtext",
      "id": "announcement_text",
      "default": "Complimentary global shipping on orders over $500",
      "label": "t:sections.aura_arc_header.settings.announcement_text.label"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "t:sections.aura_arc_header.settings.announcement_link.label"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "default": "#161619",
      "label": "t:sections.aura_arc_header.settings.announcement_bg.label"
    },
    {
      "type": "color",
      "id": "announcement_color",
      "default": "#f2ca50",
      "label": "t:sections.aura_arc_header.settings.announcement_color.label"
    },
    {
      "type": "select",
      "id": "position_mode",
      "options": [
        {
          "value": "sticky",
          "label": "t:sections.aura_arc_header.settings.position_mode.options__1.label"
        },
        {
          "value": "fixed",
          "label": "t:sections.aura_arc_header.settings.position_mode.options__2.label"
        },
        {
          "value": "static",
          "label": "t:sections.aura_arc_header.settings.position_mode.options__3.label"
        }
      ],
      "default": "sticky",
      "label": "t:sections.aura_arc_header.settings.position_mode.label"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.aura_arc_header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.logo_width.label",
      "default": 140
    },
    {
      "type": "text",
      "id": "brand_title",
      "default": "Lumen & Co.",
      "label": "t:sections.aura_arc_header.settings.brand_title.label"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "default": true,
      "label": "t:sections.aura_arc_header.settings.show_title.label"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.aura_arc_header.settings.menu.label"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#f2ca50",
      "label": "t:sections.aura_arc_header.settings.accent_color.label"
    },
    {
      "type": "range",
      "id": "header_height",
      "min": 50,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "t:sections.aura_arc_header.settings.header_height.label",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:sections.header.name"
    }
  ]
}
{% endschema %}
